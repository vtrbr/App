<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Tedflix" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#E51C2A</item>
        <item name="android:navigationBarColor">#050609</item>
        <item name="android:statusBarColor">#050609</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/tedflix_splash_background</item>
    </style>

    <style name="Theme.Tedflix.Splash" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:navigationBarColor">#050609</item>
        <item name="android:statusBarColor">#050609</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/tedflix_splash_background</item>
    </style>

    <style name="TedflixDialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/tedflix_dialog_background</item>
        <item name="android:colorAccent">#E51C2A</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#B8BBC6</item>
        <item name="android:textColorHint">#858895</item>
        <item name="android:windowMinWidthMajor">88%</item>
        <item name="android:windowMinWidthMinor">92%</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
    </style>

    <style name="Theme.Tedflix.Player" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#E51C2A</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
